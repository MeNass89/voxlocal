# Copy to a Pod-local file and source it from the image entrypoint. Never commit
# a real token or endpoint URL. Commands must bind their service to loopback;
# expose only the reviewed HTTPS port at the Pod boundary.
VOXLOCAL_ROOT=/workspace/voxlocal
VOXLOCAL_TOKEN_FILE=/workspace/voxlocal/api-token
VOXLOCAL_VOICE_CMD='python -m <voice_server> --host 127.0.0.1 --port 8001 --model large-v3'
VOXLOCAL_CLEAN_CMD='python -m <clean_server> --host 127.0.0.1 --port 8002 --model <small-model>'
# Enable only after a separate benchmark and approved model/configuration.
# VOXLOCAL_LLM_CMD='python -m <llm_server> --host 127.0.0.1 --port 8003 --model <qwen-model>'
